<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the standard quotation/order report -->
    <template id="report_saleorder_document_rental" inherit_id="sale.report_saleorder_document">
        
        <!-- Add rental details section after the partner address -->
        <xpath expr="//div[@id='informations']" position="after">
            <t t-if="doc.rental_line_ids">
                <div class="page-break">
                    <h3 style="color: #875A7B; margin-top: 30px; margin-bottom: 20px; border-bottom: 2px solid #875A7B; padding-bottom: 10px;">
                        🚗 Vehicle Rental Details
                    </h3>
                    
                    <table class="table table-sm" style="margin-bottom: 30px; border: 1px solid #dee2e6;">
                        <thead style="background-color: #875A7B; color: white;">
                            <tr>
                                <th class="text-left" style="padding: 12px; border: 1px solid #875A7B;">Vehicle</th>
                                <th class="text-center" style="padding: 12px; border: 1px solid #875A7B;">Pickup Location</th>
                                <th class="text-center" style="padding: 12px; border: 1px solid #875A7B;">From</th>
                                <th class="text-center" style="padding: 12px; border: 1px solid #875A7B;">To</th>
                                <th class="text-center" style="padding: 12px; border: 1px solid #875A7B;">Days</th>
                                <th class="text-right" style="padding: 12px; border: 1px solid #875A7B;">Daily Rate</th>
                                <th class="text-right" style="padding: 12px; border: 1px solid #875A7B;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.rental_line_ids" t-as="rental">
                                <tr style="border-bottom: 1px solid #dee2e6;">
                                    <td style="padding: 12px; border: 1px solid #dee2e6;">
                                        <strong><span t-field="rental.vehicle_id"/></strong>
                                    </td>
                                    <td class="text-center" style="padding: 12px; border: 1px solid #dee2e6;">
                                        <t t-if="rental.pickup_location == 'doha'">Doha</t>
                                        <t t-elif="rental.pickup_location == 'wakra'">Al Wakra</t>
                                        <t t-elif="rental.pickup_location == 'alkhor'">Al Khor</t>
                                    </td>
                                    <td class="text-center" style="padding: 12px; border: 1px solid #dee2e6;">
                                        <span t-field="rental.start_date" t-options='{"format": "dd/MM/yyyy"}'/>
                                    </td>
                                    <td class="text-center" style="padding: 12px; border: 1px solid #dee2e6;">
                                        <span t-field="rental.end_date" t-options='{"format": "dd/MM/yyyy"}'/>
                                    </td>
                                    <td class="text-center" style="padding: 12px; border: 1px solid #dee2e6;">
                                        <strong><span t-field="rental.days"/></strong>
                                    </td>
                                    <td class="text-right" style="padding: 12px; border: 1px solid #dee2e6;">
                                        <span t-field="rental.rent_price" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                    <td class="text-right" style="padding: 12px; border: 1px solid #dee2e6; background-color: #f8f9fa;">
                                        <strong><span t-field="rental.subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></strong>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    
                    <div style="margin-top: 20px; padding: 15px; background-color: #f0f8ff; border-left: 4px solid #875A7B; margin-bottom: 30px;">
                        <p style="margin: 0; font-size: 12px;">
                            <strong>📋 Rental Terms:</strong><br/>
                            • Vehicle must be returned to the same pickup location<br/>
                            • Valid driver's license required<br/>
                            • Fuel policy: Return with same fuel level<br/>
                            • Late return charges may apply
                        </p>
                    </div>
                </div>
            </t>
        </xpath>

        <!-- Hide the standard order lines table when rental lines exist -->
        <xpath expr="//table[hasclass('o_main_table')]" position="attributes">
            <attribute name="t-if">not doc.rental_line_ids</attribute>
        </xpath>

    </template>

    <!-- Inherit invoice report to show rental details -->
    <template id="report_invoice_document_rental" inherit_id="account.report_invoice_document" priority="20">
        
        <!-- Hide standard invoice lines when rental exists -->
        <xpath expr="//table[@name='invoice_line_table']" position="attributes">
            <attribute name="t-if">not (o.invoice_origin and request.env['sale.order'].search([('name', '=', o.invoice_origin)], limit=1).rental_line_ids)</attribute>
        </xpath>
        
        <!-- Add rental table before the standard table -->
        <xpath expr="//table[@name='invoice_line_table']" position="before">
            <t t-if="o.invoice_origin">
                <t t-set="sale_order" t-value="request.env['sale.order'].search([('name', '=', o.invoice_origin)], limit=1)"/>
                <t t-if="sale_order and sale_order.rental_line_ids">
                    
                    <table class="table table-sm o_main_table" name="rental_invoice_table" style="margin-bottom: 30px; border: 1px solid #dee2e6;">
                        <thead style="background-color: #875A7B; color: white;">
                            <tr>
                                <th class="text-left" style="padding: 12px; border: 1px solid #875A7B;">Vehicle</th>
                                <th class="text-center" style="padding: 12px; border: 1px solid #875A7B;">Pickup</th>
                                <th class="text-center" style="padding: 12px; border: 1px solid #875A7B;">From</th>
                                <th class="text-center" style="padding: 12px; border: 1px solid #875A7B;">To</th>
                                <th class="text-center" style="padding: 12px; border: 1px solid #875A7B;">Duration</th>
                                <th class="text-right" style="padding: 12px; border: 1px solid #875A7B;">Price</th>
                                <th class="text-right" style="padding: 12px; border: 1px solid #875A7B;">Taxes</th>
                                <th class="text-right" style="padding: 12px; border: 1px solid #875A7B;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="sale_order.rental_line_ids" t-as="rental">
                                <tr style="border-bottom: 1px solid #dee2e6;">
                                    <td style="padding: 12px; border: 1px solid #dee2e6;">
                                        <strong><span t-field="rental.vehicle_id"/></strong>
                                    </td>
                                    <td class="text-center" style="padding: 12px; border: 1px solid #dee2e6;">
                                        <t t-if="rental.pickup_location == 'doha'">Doha</t>
                                        <t t-elif="rental.pickup_location == 'wakra'">Al Wakra</t>
                                        <t t-elif="rental.pickup_location == 'alkhor'">Al Khor</t>
                                    </td>
                                    <td class="text-center" style="padding: 12px; border: 1px solid #dee2e6;">
                                        <span t-field="rental.start_date" t-options='{"format": "dd/MM/yyyy"}'/>
                                    </td>
                                    <td class="text-center" style="padding: 12px; border: 1px solid #dee2e6;">
                                        <span t-field="rental.end_date" t-options='{"format": "dd/MM/yyyy"}'/>
                                    </td>
                                    <td class="text-center" style="padding: 12px; border: 1px solid #dee2e6;">
                                        <strong><span t-field="rental.days"/> day(s)</strong>
                                    </td>
                                    <td class="text-right" style="padding: 12px; border: 1px solid #dee2e6;">
                                        <span t-field="rental.rent_price" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td class="text-right" style="padding: 12px; border: 1px solid #dee2e6;">
                                        <t t-set="order_line" t-value="o.invoice_line_ids.filtered(lambda l: rental.vehicle_id.name in l.name)[:1]"/>
                                        <span t-if="order_line" t-esc="'%.2f QR' % (sum(order_line.mapped('price_total')) - sum(order_line.mapped('price_subtotal')))"/>
                                        <span t-else="">0.00 QR</span>
                                    </td>
                                    <td class="text-right" style="padding: 12px; border: 1px solid #dee2e6; background-color: #f8f9fa;">
                                        <strong><span t-field="rental.subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></strong>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    
                </t>
            </t>
        </xpath>

    </template>

</odoo>
