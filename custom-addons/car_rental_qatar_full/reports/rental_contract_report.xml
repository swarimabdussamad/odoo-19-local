<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Report Definition -->
    <record id="action_report_rental_contract" model="ir.actions.report">
        <field name="name">Rental Contract</field>
        <field name="model">rental.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">car_rental_qatar_full.report_rental_contract_document</field>
        <field name="report_file">car_rental_qatar_full.report_rental_contract_document</field>
        <field name="binding_model_id" ref="model_rental_contract"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Report Template -->
    <template id="report_rental_contract_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        
                        <!-- Header -->
                        <div class="text-center" style="border-bottom: 3px solid #875A7B; padding-bottom: 15px; margin-bottom: 30px;">
                            <h2 style="color: #875A7B; margin: 0;">CAR RENTAL CONTRACT</h2>
                            <p style="margin: 5px 0;">Contract No: <strong><span t-field="o.name"/></strong></p>
                        </div>

                        <!-- Customer & Vehicle Info -->
                        <div class="row" style="margin-bottom: 30px;">
                            <div class="col-6">
                                <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px;">Customer Information</h5>
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td><strong>Name:</strong></td>
                                        <td><span t-field="o.customer_id"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Phone:</strong></td>
                                        <td><span t-field="o.customer_phone"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Email:</strong></td>
                                        <td><span t-field="o.customer_email"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px;">Vehicle Information</h5>
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td><strong>Vehicle:</strong></td>
                                        <td><span t-field="o.vehicle_id"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>License Plate:</strong></td>
                                        <td><span t-field="o.vehicle_plate"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Rental Details -->
                        <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px; margin-bottom: 15px;">Rental Details</h5>
                        <table class="table table-sm" style="margin-bottom: 30px;">
                            <tr>
                                <td style="width: 25%;"><strong>Pickup Date:</strong></td>
                                <td style="width: 25%;"><span t-field="o.pickup_date" t-options='{"format": "dd/MM/yyyy HH:mm"}'/></td>
                                <td style="width: 25%;"><strong>Pickup Location:</strong></td>
                                <td style="width: 25%;">
                                    <t t-if="o.pickup_location == 'doha_airport'">Hamad International Airport</t>
                                    <t t-elif="o.pickup_location == 'city_center'">City Center</t>
                                    <t t-elif="o.pickup_location == 'al_wakrah'">Al Wakrah</t>
                                    <t t-elif="o.pickup_location == 'al_khor'">Al Khor</t>
                                    <t t-else="">Other Location</t>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Return Date:</strong></td>
                                <td><span t-field="o.return_date" t-options='{"format": "dd/MM/yyyy HH:mm"}'/></td>
                                <td><strong>Return Location:</strong></td>
                                <td>
                                    <t t-if="o.return_location == 'doha_airport'">Hamad International Airport</t>
                                    <t t-elif="o.return_location == 'city_center'">City Center</t>
                                    <t t-elif="o.return_location == 'al_wakrah'">Al Wakrah</t>
                                    <t t-elif="o.return_location == 'al_khor'">Al Khor</t>
                                    <t t-else="">Other Location</t>
                                </td>
                            </tr>
                        </table>

                        <!-- Pricing -->
                        <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px; margin-bottom: 15px;">Pricing</h5>
                        <table class="table table-bordered" style="margin-bottom: 30px;">
                            <thead style="background-color: #875A7B; color: white;">
                                <tr>
                                    <th>Description</th>
                                    <th class="text-right">Amount (QAR)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Daily Rate</td>
                                    <td class="text-right"><span t-field="o.daily_rate"/></td>
                                </tr>
                                <tr>
                                    <td>Total Days</td>
                                    <td class="text-right"><span t-field="o.total_days"/></td>
                                </tr>
                                <tr style="background-color: #f8f9fa;">
                                    <td><strong>Rental Amount</strong></td>
                                    <td class="text-right"><strong><span t-field="o.rental_amount"/></strong></td>
                                </tr>
                                <tr>
                                    <td><strong>Security Deposit</strong></td>
                                    <td class="text-right"><strong><span t-field="o.security_deposit"/></strong></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Mileage -->
                        <t t-if="o.odometer_start or o.odometer_end">
                            <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px; margin-bottom: 15px;">Mileage Information</h5>
                            <table class="table table-sm table-borderless" style="margin-bottom: 30px;">
                                <tr>
                                    <td style="width: 33%;"><strong>Start Odometer:</strong> <span t-field="o.odometer_start"/> km</td>
                                    <td style="width: 33%;"><strong>End Odometer:</strong> <span t-field="o.odometer_end"/> km</td>
                                    <td style="width: 33%;"><strong>Total KM:</strong> <span t-field="o.total_km"/> km</td>
                                </tr>
                            </table>
                        </t>

                        <!-- Terms & Conditions -->
                        <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px; margin-bottom: 15px;">Terms &amp; Conditions</h5>
                        <div style="font-size: 11px; margin-bottom: 30px;">
                            <ul>
                                <li>Valid driver's license and ID required at pickup</li>
                                <li>Vehicle must be returned with the same fuel level</li>
                                <li>Security deposit will be refunded after vehicle inspection</li>
                                <li>Late return charges: 50 QAR per hour</li>
                                <li>Customer is responsible for any traffic violations during rental period</li>
                                <li>Insurance coverage as per Qatar traffic law</li>
                            </ul>
                        </div>

                        <!-- Signatures -->
                        <div class="row" style="margin-top: 50px;">
                            <div class="col-6 text-center">
                                <div style="border-top: 2px solid #000; display: inline-block; width: 200px; padding-top: 5px;">
                                    <strong>Customer Signature</strong>
                                </div>
                                <p style="margin-top: 10px; font-size: 11px;">Date: _______________</p>
                            </div>
                            <div class="col-6 text-center">
                                <div style="border-top: 2px solid #000; display: inline-block; width: 200px; padding-top: 5px;">
                                    <strong>Company Representative</strong>
                                </div>
                                <p style="margin-top: 10px; font-size: 11px;">Date: _______________</p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
