<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Customer Document Tree View -->
    <record id="view_customer_document_tree" model="ir.ui.view">
        <field name="name">customer.document.tree</field>
        <field name="model">customer.document</field>
        <field name="arch" type="xml">
            <list string="Customer Documents" 
                   decoration-danger="is_expired" 
                   decoration-warning="days_to_expiry &lt; 30 and not is_expired">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="document_type"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry"/>
                <field name="is_expired" column_invisible="1"/>
                <field name="verified" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Customer Document Form View -->
    <record id="view_customer_document_form" model="ir.ui.view">
        <field name="name">customer.document.form</field>
        <field name="model">customer.document</field>
        <field name="arch" type="xml">
            <form string="Customer Document">
                <header>
                    <button name="action_verify" string="Verify" 
                            type="object" class="oe_highlight" 
                            invisible="verified"/>
                    <button name="action_unverify" string="Unverify" 
                            type="object" 
                            invisible="not verified"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger" 
                            invisible="not is_expired"/>
                    <widget name="web_ribbon" title="Expiring Soon" bg_color="text-bg-warning" 
                            invisible="is_expired or days_to_expiry &gt; 30"/>
                    <widget name="web_ribbon" title="Verified" bg_color="text-bg-success" 
                            invisible="not verified"/>
                    
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="document_type"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="issuing_country"/>
                        </group>
                    </group>
                    
                    <group string="Document Status">
                        <group>
                            <field name="is_expired"/>
                            <field name="days_to_expiry"/>
                        </group>
                        <group>
                            <field name="verified"/>
                            <field name="verified_by" readonly="1" invisible="not verified"/>
                            <field name="verified_date" readonly="1" invisible="not verified"/>
                        </group>
                    </group>
                    
                    <group string="Document Copy">
                        <field name="document_file" filename="document_filename" widget="binary"/>
                        <field name="document_filename" invisible="1"/>
                    </group>
                    
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Additional notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Customer Document Action -->
    <record id="action_customer_document" model="ir.actions.act_window">
        <field name="name">Customer Documents</field>
        <field name="res_model">customer.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Extend Partner Form View -->
    <record id="view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            
            <!-- Add smart button for documents -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_documents" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-file-text">
                    <field name="document_count" widget="statinfo" string="Documents"/>
                </button>
            </xpath>
            
            <!-- Add Qatar-specific fields -->
            <xpath expr="//page[@name='contact_addresses']" position="after">
                <page string="Rental Information" name="rental_info">
                    <group>
                        <group string="Personal Information">
                            <field name="customer_type"/>
                            <field name="date_of_birth"/>
                            <field name="age"/>
                            <field name="nationality_id"/>
                        </group>
                        <group string="Document Quick Reference">
                            <field name="qatar_id_number"/>
                            <field name="passport_number"/>
                            <field name="driving_license_number"/>
                            <field name="license_expiry_date"/>
                        </group>
                    </group>
                    
                    <group string="Uploaded Documents">
                        <field name="document_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="document_type"/>
                                <field name="name"/>
                                <field name="expiry_date"/>
                                <field name="days_to_expiry"/>
                                <field name="verified" widget="boolean_toggle"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
            
        </field>
    </record>

    <!-- Add to Menu -->
    <menuitem id="menu_customer_documents" 
              name="Customer Documents" 
              parent="menu_car_rental_operations" 
              action="action_customer_document" 
              sequence="30"/>

</odoo>