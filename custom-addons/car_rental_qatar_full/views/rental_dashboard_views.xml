<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard Form View -->
    <record id="view_rental_dashboard_form" model="ir.ui.view">
        <field name="name">rental.dashboard.form</field>
        <field name="model">rental.dashboard</field>
        <field name="arch" type="xml">
            <form string="Rental Dashboard" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>Car Rental Dashboard</h1>
                        <h3>Real-time Operations Overview</h3>
                    </div>
                    
                    <!-- Fleet Statistics -->
                    <group string="Fleet Overview">
                        <group>
                            <button name="action_view_available_vehicles" 
                                    type="object" 
                                    class="oe_stat_button" 
                                    icon="fa-car">
                                <div class="o_field_widget o_stat_info">
                                    <field name="available_vehicles" class="o_stat_value"/>
                                    <span class="o_stat_text">Available</span>
                                </div>
                            </button>
                            <button name="action_view_active_rentals" 
                                    type="object" 
                                    class="oe_stat_button" 
                                    icon="fa-key">
                                <div class="o_field_widget o_stat_info">
                                    <field name="rented_vehicles" class="o_stat_value"/>
                                    <span class="o_stat_text">Rented</span>
                                </div>
                            </button>
                        </group>
                        <group>
                            <field name="total_vehicles" readonly="1"/>
                            <field name="maintenance_vehicles" readonly="1"/>
                            <field name="utilization_rate" readonly="1" widget="percentage"/>
                        </group>
                    </group>
                    
                    <!-- Today's Operations -->
                    <group string="Today's Operations">
                        <group>
                            <button name="action_view_pickups_today" 
                                    type="object" 
                                    class="oe_stat_button" 
                                    icon="fa-sign-in">
                                <div class="o_field_widget o_stat_info">
                                    <field name="pickups_today" class="o_stat_value"/>
                                    <span class="o_stat_text">Pickups</span>
                                </div>
                            </button>
                            <button name="action_view_returns_today" 
                                    type="object" 
                                    class="oe_stat_button" 
                                    icon="fa-sign-out">
                                <div class="o_field_widget o_stat_info">
                                    <field name="returns_today" class="o_stat_value"/>
                                    <span class="o_stat_text">Returns</span>
                                </div>
                            </button>
                        </group>
                        <group>
                            <field name="active_rentals" readonly="1"/>
                            <button name="action_view_overdue_returns" 
                                    type="object" 
                                    class="oe_stat_button text-danger" 
                                    icon="fa-exclamation-triangle">
                                <div class="o_field_widget o_stat_info">
                                    <field name="overdue_returns" class="o_stat_value"/>
                                    <span class="o_stat_text">Overdue</span>
                                </div>
                            </button>
                        </group>
                    </group>
                    
                    <!-- Revenue Statistics -->
                    <group string="Revenue Overview">
                        <group>
                            <field name="revenue_today" readonly="1" widget="monetary"/>
                            <field name="revenue_month" readonly="1" widget="monetary"/>
                        </group>
                        <group>
                            <field name="revenue_year" readonly="1" widget="monetary"/>
                        </group>
                    </group>
                    
                    <!-- Customer Statistics -->
                    <group string="Customer Statistics">
                        <group>
                            <field name="total_customers" readonly="1"/>
                            <field name="new_customers_month" readonly="1"/>
                        </group>
                    </group>
                    
                </sheet>
            </form>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="action_rental_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">rental.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>

    <!-- Add Dashboard to Menu (First Item) -->
    <menuitem id="menu_rental_dashboard" 
              name="Dashboard" 
              parent="menu_car_rental_root" 
              action="action_rental_dashboard" 
              sequence="1"/>

</odoo>