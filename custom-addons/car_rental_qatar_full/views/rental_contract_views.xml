<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- List View -->
    <record id="view_rental_contract_tree" model="ir.ui.view">
        <field name="name">rental.contract.list</field>
        <field name="model">rental.contract</field>
        <field name="arch" type="xml">
            <list string="Rental Contracts" decoration-info="state=='draft'" 
                  decoration-success="state=='ongoing'" decoration-muted="state in ('completed','cancelled')">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="vehicle_plate"/>
                <field name="pickup_date"/>
                <field name="return_date"/>
                <field name="total_days"/>
                <field name="rental_amount"/>
                <field name="state" widget="badge" 
                       decoration-info="state=='draft'"
                       decoration-warning="state=='confirmed'"
                       decoration-success="state=='ongoing'"
                       decoration-primary="state=='completed'"
                       decoration-muted="state=='cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_rental_contract_form" model="ir.ui.view">
        <field name="name">rental.contract.form</field>
        <field name="model">rental.contract</field>
        <field name="arch" type="xml">
            <form string="Rental Contract">
                <header>
                    <button name="%(action_report_rental_contract)d" string="Print Contract" 
                            type="action" 
                            invisible="state == 'draft'"
                            class="oe_highlight"/>
                    <button name="action_confirm" string="Confirm" 
                            type="object" class="oe_highlight" 
                            invisible="state != 'draft'"/>
                    <button name="action_start_rental" string="Start Rental" 
                            type="object" class="oe_highlight" 
                            invisible="state != 'confirmed'"/>
                    <button name="action_complete_rental" string="Complete Rental" 
                            type="object" class="oe_highlight" 
                            invisible="state != 'ongoing'"/>
                    <button name="action_cancel" string="Cancel" 
                            type="object" 
                            invisible="state in ('completed','cancelled')"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,confirmed,ongoing,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Customer Information">
                            <field name="customer_id"/>
                            <field name="customer_phone"/>
                            <field name="customer_email"/>
                        </group>
                        <group string="Vehicle Information">
                            <field name="vehicle_id"/>
                            <field name="vehicle_plate"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Rental Period">
                            <field name="pickup_date"/>
                            <field name="pickup_location"/>
                            <field name="return_date"/>
                            <field name="return_location"/>
                            <field name="actual_return_date" readonly="1" 
                                   invisible="not actual_return_date"/>
                        </group>
                        <group string="Pricing">
                            <field name="daily_rate"/>
                            <field name="total_days" readonly="1"/>
                            <field name="rental_amount" readonly="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Mileage Information">
                            <field name="odometer_start"/>
                            <field name="odometer_end"/>
                            <field name="total_km" readonly="1"/>
                        </group>
                        <group string="Security Deposit">
                            <field name="security_deposit"/>
                            <field name="deposit_paid"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <!-- Search View - Temporarily Disabled
    <record id="view_rental_contract_search" model="ir.ui.view">
        <field name="name">rental.contract.search</field>
        <field name="model">rental.contract</field>
