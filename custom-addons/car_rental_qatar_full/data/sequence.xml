<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Rental Contract Sequence -->
        <record id="seq_rental_contract" model="ir.sequence">
            <field name="name">Rental Contract Sequence</field>
            <field name="code">rental.contract</field>
            <field name="prefix">RC</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Vehicle Inspection Sequence -->
        <record id="seq_vehicle_inspection" model="ir.sequence">
            <field name="name">Vehicle Inspection Sequence</field>
            <field name="code">vehicle.inspection</field>
            <field name="prefix">INS</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>