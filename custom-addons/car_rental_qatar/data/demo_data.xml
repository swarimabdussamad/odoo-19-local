<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Vehicle Rental Categories -->
        <record id="category_economy" model="fleet.vehicle.category">
            <field name="name">Economy</field>
            <field name="sequence">10</field>
            <field name="daily_rate">100.00</field>
            <field name="description">Budget-friendly vehicles for everyday use</field>
        </record>

        <record id="category_compact" model="fleet.vehicle.category">
            <field name="name">Compact</field>
            <field name="sequence">20</field>
            <field name="daily_rate">150.00</field>
            <field name="description">Comfortable mid-size vehicles</field>
        </record>

        <record id="category_suv" model="fleet.vehicle.category">
            <field name="name">SUV</field>
            <field name="sequence">30</field>
            <field name="daily_rate">250.00</field>
            <field name="description">Spacious SUVs for families</field>
        </record>

        <record id="category_luxury" model="fleet.vehicle.category">
            <field name="name">Luxury</field>
            <field name="sequence">40</field>
            <field name="daily_rate">400.00</field>
            <field name="description">Premium luxury vehicles</field>
        </record>

    </data>
</odoo>